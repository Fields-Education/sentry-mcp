/**
 * Fields fork of Sentry MCP Cloudflare worker
 * Deploys to: sentry-mcp-fields.workers.dev
 * Points to self-hosted Sentry at: s.fields.app
 *
 * Required secrets (set via `wrangler secret put <NAME>`):
 *   - SENTRY_CLIENT_ID      : OAuth app client ID from s.fields.app
 *   - SENTRY_CLIENT_SECRET  : OAuth app client secret
 *   - COOKIE_SECRET         : Session encryption (32+ chars)
 *   - OPENROUTER_API_KEY    : For hosted chat and AI features
 *   - SENTRY_DSN            : DSN from s.fields.app for error reporting
 *   - SENTRY_HOST           : s.fields.app
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentry-mcp-fields",
  "main": "./src/server/index.ts",
  "compatibility_date": "2025-03-21",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {},
  "unsafe": {
    "bindings": [
      {
        "name": "CHAT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3001",
        "simple": {
          "limit": 100,
          "period": 60
        }
      },
      {
        "name": "SEARCH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3002",
        "simple": {
          "limit": 200,
          "period": 60
        }
      },
      // Upstream split the single MCP limiter into dedicated per-IP and
      // per-user limiters. Fields keeps its elevated 600/min ceiling on both,
      // matching the effective behaviour of the previous MCP_RATE_LIMITER.
      {
        "name": "MCP_IP_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3003",
        "simple": {
          "limit": 600,
          "period": 60
        }
      },
      {
        "name": "MCP_USER_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3004",
        "simple": {
          "limit": 600,
          "period": 60
        }
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "457468efd8d04a168cbf90bb1cc60e01"
    }
    // TODO(fields): upstream added an `MCP_CACHE` KV binding used to cache
    // OAuth constraint verification. It needs a namespace in the Fields
    // Cloudflare account before it can be wired up:
    //   pnpm exec wrangler kv namespace create MCP_CACHE
    // then add: { "binding": "MCP_CACHE", "id": "<new-id>" }
    // Until then constraint caching fails open (every verification hits the
    // Sentry API and logs a "Failed to read constraints cache" warning).
  ],
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    {
      "tag": "v1"
    },
    {
      "tag": "v2"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "tail_consumers": [],
  "dev": {
    "port": 8790
  }
}
